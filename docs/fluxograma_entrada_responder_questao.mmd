flowchart TD
  subgraph F["Frontend — estudar.js"]
    A(["Aluno escolhe a alternativa e clica em Continuar"]) --> B["fetch POST /api/learning/challenges/{id}/answer<br/>{ id_questao, alternativa, segundos_gastos }"]
    Z(["Mostra correção, explicação e pontos<br/>e marca ✓ ou ✗ na bolinha do mapa"])
  end
  subgraph C["Controller — aprendizado_controller.py"]
    C1{"@rota: há aluno<br/>na sessão?"}
    C2["responder_questao() chama RespostaService"]
    C3["jsonify(resultado) → HTTP 200"]
    E401["HTTP 401"]
    EERR["HTTP 400 / 404 / 409<br/>(ErroDeNegocio)"]
  end
  subgraph S["Service — RespostaService.responder()"]
    S1{"Alternativa A–D<br/>e id válidos?"}
    S2{"Questão pertence a um<br/>desafio deste aluno?"}
    S3{"Já respondida?"}
    S4{"Respondendo<br/>na ordem?"}
    S5["Corrige e calcula pontos (regras.py)<br/>acerto: +10/15/20 · erro: −25% · revisão: 0<br/>atualiza foguinho (sequência diária)"]
    S6["Monta JSON: correta, alternativa_correta,<br/>explicacao, pontos_ganhos, pontos_totais"]
  end
  subgraph R["Repository"]
    R1["DesafioRepository.buscar_por_id<br/>QuestaoRepository.buscar_por_id<br/>DesafioQuestaoRepository.pertence"]
    R2["RespostaRepository.buscar"]
    R3["DesafioQuestaoRepository.ids_questoes<br/>RespostaRepository.listar"]
    R4["RespostaRepository.adicionar(RespostaDesafio)<br/>Transacao.confirmar()"]
  end
  subgraph M["Model / Banco"]
    MO["Model RespostaDesafio criado<br/>Model Aluno: pontos atualizados"]
    DB[("SQLite — INSERT em resposta_desafio<br/>UPDATE em Aluno")]
  end
