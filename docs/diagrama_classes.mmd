classDiagram
  direction LR
  class Aluno {
    -Integer id_aluno
    -String nome
    -String email
    -String senha
    -Date data_nascimento
    -Integer pontos
    -Integer foguinho
    -String nick
    -Integer minutos_ativos
    -String ultimo_dia_ativo
    -Integer sequencia_atual
    -Integer melhor_sequencia
    -Float ultimo_heartbeat
    -Integer segundos_pendentes
    -DateTime termos_aceitos_em
    -String versao_termos
    +to_dict()
  }
  class Tema {
    -Integer id_tema
    -String materia
    -String nome
    +to_dict()
  }
  class Questao {
    -Integer id_questao
    -Text enunciado
    -String alternativa_correta
    -Integer id_tema
    -Text alternativas_json
    -Text explicacao
    +to_dict()
  }
  class Desafio {
    -Integer id_desafio
    -String nome
    -String dificuldade
    -Integer pontuacao
    -Integer quantidade_questoes
    -Date data_criacao
    -Integer id_tema
    -Integer id_aluno
    -Integer nivel_mapa
    -Boolean origem_ia
    +to_dict()
  }
  class DesafioQuestao {
    -Integer id_desafio
    -Integer id_questao
    +to_dict()
  }
  class AlunoDesafio {
    -Integer id_aluno
    -Integer id_desafio
    -Date data_realizacao
    -Integer pontuacao_obtida
    -Boolean concluido
    +to_dict()
  }
  class RespostaDesafio {
    -Integer id_resposta
    -Integer id_aluno
    -Integer id_desafio
    -Integer id_questao
    -String alternativa_escolhida
    -Boolean correta
    -Integer pontos_ganhos
    -Integer segundos_gastos
    -DateTime data_resposta
    +to_dict()
  }
  class Ranking {
    -Integer id_ranking
    -Integer classificacao
    -Integer pontos
    -Integer id_aluno
    +to_dict()
  }
  Tema "1" -- "0..*" Questao : possui
  Tema "0..1" -- "0..*" Desafio : é tema de
  Aluno "0..1" -- "0..*" Desafio : joga
  Desafio "1" -- "0..*" DesafioQuestao : contém
  Questao "1" -- "0..*" DesafioQuestao : pertence
  Aluno "1" -- "0..*" AlunoDesafio : conclui
  Desafio "1" -- "0..*" AlunoDesafio : é concluído em
  Aluno "1" -- "0..*" RespostaDesafio : responde
  Desafio "1" -- "0..*" RespostaDesafio : recebe
  Questao "1" -- "0..*" RespostaDesafio : é respondida em
  Aluno "1" -- "0..*" Ranking : possui (legado)
