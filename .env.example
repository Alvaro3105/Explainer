# Necessário para assinar as sessões. Use uma chave longa e aleatória; valores de exemplo
# (como o texto abaixo) são recusados pelo app, que passa a usar uma chave temporária.
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-e-segura

# Chave do Google Gemini que gera as questões (grátis em aistudio.google.com).
# Nunca coloque a chave real no GitHub:
# no servidor ela vai nas variáveis de ambiente; no computador, no arquivo .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Deixe 0 em desenvolvimento local. Em produção HTTPS, use 1.
COOKIE_SECURE=0
FLASK_DEBUG=False

# Painel administrativo legado (index.html, listar.html...). Ele não tem login nem perfis:
# ligado, qualquer pessoa pode editar ou apagar contas. Use 1 somente em desenvolvimento local.
ENABLE_ADMIN_PANEL=0

# Origens extras autorizadas a chamar a API de outro domínio (separadas por vírgula).
# Vazio = só a própria origem do app, que é o caso normal.
CORS_ORIGINS=

# Opcional: outro banco. Aceita PostgreSQL (postgresql://usuario:senha@servidor/banco)
# ou MySQL (mysql+pymysql://usuario:senha@localhost/ExplAIner).
# Padrão: SQLite em backend/instance/explainer.db.
# DATABASE_URL=

# Opcional: limites de geração de desafios por aluno (0 desliga a regra).
# Padrões: 10 segundos entre gerações, 8 a cada 10 minutos e 40 por dia.
# INTERVALO_ENTRE_GERACOES=10
# GERACOES_POR_JANELA=8
# GERACOES_POR_DIA=40

# Opcional: contas novas por IP por hora (0 desliga). O padrão é alto porque uma
# escola inteira pode se cadastrar pelo mesmo IP.
# CADASTROS_POR_HORA_POR_IP=100

# Opcional: HSTS, em segundos. Só é enviado em HTTPS. Deixe sem definir até confirmar que
# o site funciona sempre por HTTPS: depois de enviado, o navegador recusa o site por HTTP.
# HSTS_SEGUNDOS=31536000

# Use 1 só quando o app roda atrás de um proxy, para o
# limite de tentativas de login enxergar o IP real de quem acessa.
TRUST_PROXY=0
